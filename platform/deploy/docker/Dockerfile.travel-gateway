FROM maven:3.9.9-eclipse-temurin-21 AS builder

WORKDIR /workspace

COPY services/techgroup-enterprise-travel-gateway /workspace/services/techgroup-enterprise-travel-gateway
COPY data-contracts /workspace/data-contracts

RUN mvn -f /workspace/services/techgroup-enterprise-travel-gateway/pom.xml -DskipTests package

FROM eclipse-temurin:21-jre

WORKDIR /app
COPY --from=builder /workspace/services/techgroup-enterprise-travel-gateway/target/*.jar /app/gateway.jar

EXPOSE 8080
CMD ["java", "-jar", "/app/gateway.jar"]

