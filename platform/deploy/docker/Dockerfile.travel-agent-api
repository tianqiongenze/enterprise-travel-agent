FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt requirements-etcd-legacy.txt ./
# requirements-etcd-legacy.txt (etcd3) is excluded: its sdist setup.py imports
# pkg_resources, removed in setuptools>=81, so it cannot build in a fresh env.
# Install it manually only for legacy etcd drills.
RUN pip install --no-cache-dir -r requirements.txt

COPY services/techgroup-enterprise-travel-runtime /app/services/techgroup-enterprise-travel-runtime
COPY skills /app/skills
COPY data /app/data

ENV PYTHONPATH=/app/services/techgroup-enterprise-travel-runtime

EXPOSE 8000
# TLS is opt-in: mount the certs and set TRAVEL_TLS_CERT/TRAVEL_TLS_KEY (and
# TRAVEL_TLS_CA + --ssl-certfile-style client auth when mTLS is required).
# Without those env vars the container starts plain-HTTP exactly as before.
CMD ["sh", "-c", "if [ -n \"$TRAVEL_TLS_CERT\" ] && [ -n \"$TRAVEL_TLS_KEY\" ]; then uvicorn src.travel_agent.api.app:app --host 0.0.0.0 --port 8000 --ssl-certfile \"$TRAVEL_TLS_CERT\" --ssl-keyfile \"$TRAVEL_TLS_KEY\"; else uvicorn src.travel_agent.api.app:app --host 0.0.0.0 --port 8000; fi"]

