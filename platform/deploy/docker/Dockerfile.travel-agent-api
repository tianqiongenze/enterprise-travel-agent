FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt requirements-etcd-legacy.txt ./
# requirements-etcd-legacy.txt (etcd3) is excluded: its sdist setup.py imports
# pkg_resources, removed in setuptools>=81, so it cannot build in a fresh env.
# Install it manually only for legacy etcd drills.
RUN pip install --no-cache-dir -r requirements.txt

COPY services/techgroup-enterprise-travel-runtime /app/services/techgroup-enterprise-travel-runtime
COPY skills /app/skills
COPY data /app/data

ENV PYTHONPATH=/app/services/techgroup-enterprise-travel-runtime

EXPOSE 8000
CMD ["uvicorn", "src.travel_agent.api.app:app", "--host", "0.0.0.0", "--port", "8000"]

