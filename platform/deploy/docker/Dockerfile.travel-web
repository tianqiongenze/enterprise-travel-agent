FROM node:22-alpine AS builder

WORKDIR /app
COPY apps/techgroup-enterprise-travel-web/package*.json ./
RUN npm ci

COPY apps/techgroup-enterprise-travel-web /app
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

