# Staging defaults: langgraph primary + agentscope shadow for canary comparison
TRAVEL_ORCHESTRATION_ENGINE=langgraph
TRAVEL_ORCHESTRATION_SHADOW_ENGINE=agentscope
TRAVEL_ORCHESTRATION_FALLBACK_ENGINE=langgraph
TRAVEL_ORCHESTRATION_STRICT=false
TRAVEL_MEMORY_BACKEND=vector
TRAVEL_VECTOR_BACKEND=faiss
TRAVEL_VECTOR_STRICT=true
TRAVEL_REDIS_MODE=cluster
TRAVEL_REDIS_URL=redis://redis-cluster:7000
TRAVEL_REDIS_MAX_CONNECTIONS=500
TRAVEL_EVENT_BUS=pulsar
ICEBERG_CATALOG_TYPE=hive
ICEBERG_HIVE_METASTORE_URI=thrift://hive-metastore:9083
ICEBERG_WAREHOUSE=s3://travel-lakehouse/warehouse

