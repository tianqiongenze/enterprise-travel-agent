# Production defaults: langgraph primary, agentscope as shadow rollback baseline
TRAVEL_ORCHESTRATION_ENGINE=langgraph
TRAVEL_ORCHESTRATION_SHADOW_ENGINE=agentscope
TRAVEL_ORCHESTRATION_FALLBACK_ENGINE=langgraph
TRAVEL_ORCHESTRATION_STRICT=true
TRAVEL_MEMORY_BACKEND=vector
TRAVEL_VECTOR_BACKEND=faiss
TRAVEL_VECTOR_STRICT=true
TRAVEL_REDIS_MODE=cluster
TRAVEL_REDIS_URL=redis://redis-cluster:7000
TRAVEL_REDIS_MAX_CONNECTIONS=800
TRAVEL_EVENT_BUS=pulsar
TRAVEL_REGISTRY_FAIL_FAST=true
ICEBERG_CATALOG_TYPE=hive
ICEBERG_HIVE_METASTORE_URI=thrift://hive-metastore:9083
ICEBERG_WAREHOUSE=s3://travel-lakehouse/warehouse
# --- Security / OIDC (Keycloak) ---
TRAVEL_AUTH_MODE=oidc
TRAVEL_SECURITY_MODE=oauth2
TRAVEL_OIDC_ISSUER=https://keycloak.travel.internal/realms/travel
TRAVEL_OIDC_AUDIENCE=travel-api
TRAVEL_INTERNAL_SHARED_SECRET=change-me-prod-internal-secret
# --- Embedding provider (auto: local bge -> dashscope -> hash fallback) ---
TRAVEL_EMBEDDING_BACKEND=local-model
TRAVEL_EMBEDDING_DIM=512
TRAVEL_GUARD_FAIL_CLOSED=true
